# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Supabase server-side credentials
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternative supported name:
# SUPABASE_SERVICE_ROLE_KEY=

# Admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Cal.com event URLs for each website language.
# English example: https://cal.com/your-name/enterprise-ai-strategy-session
NEXT_PUBLIC_CAL_LINK_EN=
# Romanian example: https://cal.com/your-name/sesiune-strategica-ai
NEXT_PUBLIC_CAL_LINK_RO=

# Optional legacy fallback. Used only when a language-specific variable is missing.
NEXT_PUBLIC_CAL_LINK=
